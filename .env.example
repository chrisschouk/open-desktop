# OpenDesktop + OpenWorker — copy to .env and fill in

# ── Sandbox ──────────────────────────────────────────
# local = Docker on this machine | remote = Docker on Hetzner VPS via SSH
SANDBOX_MODE=remote
SANDBOX_ENABLED=true
SANDBOX_IMAGE=opendesktop-sandbox:latest

# Remote VPS (when SANDBOX_MODE=remote)
HETZNER_HOST=          # e.g. 123.45.67.89 or vps.example.com
SSH_HOST_ALIAS=hetzner # ~/.ssh/config Host name

# Disable desktop entirely — T2/T3 auto-downgrade to browser research
# SANDBOX_ENABLED=false

# ── LLM: ONE KEY IS ENOUGH ───────────────────────────
# Easiest path: paste your OpenRouter key (starts with sk-or-)
OPENROUTER_API_KEY=

# Cheap defaults on OpenRouter (auto-selected when OPENROUTER_API_KEY is set):
# CHAT_MODEL=deepseek/deepseek-v4-flash      # T0/T1 chat + browser research
# VISION_MODEL=google/gemini-2.0-flash-001   # T2/T3 desktop vision loop

# Optional: split keys or use OpenAI directly instead
# CHAT_API_KEY=
# VISION_API_KEY=
# API_KEY=

# OpenRouter URLs (auto-selected with sk-or- key)
# CHAT_API_URL=https://openrouter.ai/api/v1/chat/completions
# VISION_API_URL=https://openrouter.ai/api/v1/chat/completions

# OpenAI direct
# CHAT_API_URL=https://api.openai.com/v1/chat/completions
# CHAT_MODEL=gpt-4o-mini
# VISION_API_URL=https://api.openai.com/v1/chat/completions
# VISION_MODEL=gpt-4o-mini

# ── OpenWorker ───────────────────────────────────────
DEFAULT_PERSONA=openworker
OPENDESKTOP_DATA_DIR=./data

# ── Optional ───────────────────────────────────────
# OPENDESKTOP_API_TOKEN=   # Bearer auth for gateway/MCP when exposed publicly
# DISCORD_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=
# SCHEDULER_ENABLED=true
