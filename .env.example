# OpenDesktop + OpenWorker — copy to .env and fill in

# ── Sandbox ──────────────────────────────────────────
# local = Docker on this machine | remote = SSH to VPS
SANDBOX_MODE=local
SANDBOX_IMAGE=opendesktop-sandbox:latest
# AUTO_PROVISION_FLEET=true
# HETZNER_HOST=
# SSH_HOST_ALIAS=hetzner

# ── LLM (chat = fast replies, vision = desktop control) ──
CHAT_API_KEY=
CHAT_API_URL=https://api.openai.com/v1/chat/completions
CHAT_MODEL=gpt-4o-mini

VISION_API_KEY=
VISION_API_URL=https://api.openai.com/v1/chat/completions
VISION_MODEL=gpt-4o-mini

# Ollama example (local):
# CHAT_API_URL=http://localhost:11434/v1/chat/completions
# CHAT_MODEL=llama3.1
# VISION_API_URL=http://localhost:11434/v1/chat/completions
# VISION_MODEL=llava

# ── OpenWorker persona ───────────────────────────────
DEFAULT_PERSONA=openworker
OPENDESKTOP_DATA_DIR=./data
OPENDESKTOP_VAULT_PATH=./data/vault

# ── Connectors (optional) ────────────────────────────
# DISCORD_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=
# OPENDESKTOP_API_TOKEN=   # Optional: require Bearer token on /gateway/dispatch and /tools/call
